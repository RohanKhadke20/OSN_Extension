{
  "name": "osn-guard",
  "version": "1.3.0",
  "description": "OSN Guard - Safety & Privacy Shield for Social Networks",
  "private": true,
  "scripts": {
    "check": "node --check background.js content.js core/*.js options/*.js popup/*.js scripts/*.js tests/*.test.js tests/e2e/*.js",
    "pack": "node scripts/pack.js",
    "pack:chrome": "node scripts/pack.js --target=chrome",
    "pack:firefox": "node scripts/pack.js --target=firefox",
    "pack:safari": "node scripts/pack.js --target=safari",
    "pack:all": "node scripts/pack.js --target=all",
    "bench": "node scripts/bench.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js"
  },
  "keywords": [
    "chrome-extension",
    "privacy",
    "security",
    "pii-detection",
    "phishing-protection",
    "anti-scam"
  ],
  "author": "",
  "license": "MIT"
}
